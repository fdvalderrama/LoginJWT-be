## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
[Bb]uild/
[Ll]og/
[Ll]ogs/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio
.vs/
.vscode/

# NuGet packages
*.nupkg
# Include package sources
!**/packages/build/
packages/
.nuget/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
*.deps.json
*.runtimeconfig.json

# Backup & caches
*_i.c
*_p.c
*.tmp
*.bak
*.ncb
*.cache
*.dbmdl
*.dbproj.schemaview
*.jfm

# Rider / JetBrains
.idea/

# Azure publishing
.publishsettings
*.azurePubxml

# Entity Framework Migrations build artifacts
*Migrations/*Designer.cs

# OS generated files
.DS_Store
Thumbs.db

# Logs & database
*.log
*.ldf
*.mdf
*.ndf

# Test results
TestResult*/
TestResults/
*.coverage
*.coveragexml

# VS Code settings
*.code-workspace

# Resharper
_ReSharper*/
*.DotSettings.user

# Generated files
Generated*/
